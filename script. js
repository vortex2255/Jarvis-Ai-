const response = document.getElementById("response");
const mic = document.getElementById("mic");

const SpeechRecognition =
  window.SpeechRecognition || window.webkitSpeechRecognition;

if (!SpeechRecognition) {
  response.innerHTML = "Voice recognition is not supported.";
} else {

  const recognition = new SpeechRecognition();

  recognition.lang = "en-IN";
  recognition.continuous = false;
  recognition.interimResults = false;

  mic.addEventListener("click", () => {

    response.innerHTML = "🎤 Listening, sir...";

    try {
      recognition.start();
    } catch (error) {
      console.log(error);
    }
  });

  recognition.addEventListener("result", (event) => {

    const command =
      event.results[0][0].transcript.trim();

    console.log("You said:", command);

    response.innerHTML =
      "You said:<br><strong>" + command + "</strong>";

    setTimeout(() => {
      jarvisReply(command);
    }, 500);
  });

  recognition.addEventListener("error", (event) => {

    console.log("Speech error:", event.error);

    response.innerHTML =
      "⚠️ I couldn't process that. Please try again.";
  });

  recognition.addEventListener("end", () => {
    console.log("Listening ended");
  });
}


function jarvisReply(command) {

  const text = command.toLowerCase();

  let reply = "";

  if (text.includes("hello") || text.includes("hi")) {

    reply = "Hello, sir. How may I assist you?";

  } else if (
    text.includes("your name") ||
    text.includes("who are you")
  ) {

    reply = "I am JARVIS, your personal AI assistant.";

  } else if (text.includes("time")) {

    reply =
      "The current time is " +
      new Date().toLocaleTimeString("en-IN");

  } else if (text.includes("how are you")) {

    reply =
      "I am functioning perfectly, sir.";

  } else {

    reply =
      "I heard you say: " +
      command +
      ". My full AI brain is coming soon, sir.";
  }

  response.innerHTML = reply;

  speak(reply);
}


function speak(text) {

  if (!("speechSynthesis" in window)) {
    return;
  }

  window.speechSynthesis.cancel();

  const speech =
    new SpeechSynthesisUtterance(text);

  speech.lang = "en-IN";
  speech.rate = 0.9;
  speech.pitch = 0.9;

  window.speechSynthesis.speak(speech);
}
