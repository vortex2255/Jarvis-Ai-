const response = document.getElementById("response");
const mic = document.getElementById("mic");

response.innerHTML = "JARVIS SYSTEM READY";

mic.onclick = function () {
    response.innerHTML = "BUTTON WORKING...";

    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
        response.innerHTML =
            "❌ Speech recognition is not supported by this browser.";
        return;
    }

    const recognition = new SpeechRecognition();

    recognition.lang = "en-IN";
    recognition.continuous = false;
    recognition.interimResults = false;

    response.innerHTML = "🎤 LISTENING...";

    recognition.onresult = function (event) {

        const command =
            event.results[0][0].transcript;

        response.innerHTML =
            "YOU SAID:<br>" + command;

        jarvis(command);
    };

    recognition.onerror = function (event) {

        response.innerHTML =
            "❌ ERROR:<br>" + event.error;

        console.log(event.error);
    };

    recognition.onend = function () {

        console.log("Recognition ended");
    };

    try {
        recognition.start();
    } catch (error) {
        response.innerHTML =
            "❌ Could not start microphone.";
        console.log(error);
    }
};


function jarvis(command) {

    command = command.toLowerCase();

    let answer;

    if (command.includes("hello")) {

        answer = "Hello sir. How may I assist you?";

    } else if (command.includes("your name")) {

        answer = "I am JARVIS, your personal AI assistant.";

    } else if (command.includes("time")) {

        answer =
            "The time is " +
            new Date().toLocaleTimeString();

    } else {

        answer =
            "I heard you say " +
            command +
            ". My AI brain is still under development.";

    }

    response.innerHTML = answer;

    speak(answer);
}


function speak(text) {

    const speech =
        new SpeechSynthesisUtterance(text);

    speech.lang = "en-IN";
    speech.rate = 0.9;
    speech.pitch = 0.9;

    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(speech);
}
